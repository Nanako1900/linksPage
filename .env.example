# .env.example: comments must be on their own line; leave optional variables
# commented out instead of writing empty assignments.

# Required: public URL, no trailing slash
LP_BASE_URL=https://links.example.com

# Image tag: 0.x before 1.0
LINKSPAGE_TAG=0.1

# Optional components (tunnel, backup), written by init.sh
COMPOSE_PROFILES=

# Trusted proxies for the orange-cloud or reverse-proxy setup (docs 4.9)
# LP_TRUSTED_PROXIES=172.31.255.2/32

# Client IP header; use X-Forwarded-For behind your own reverse proxy
# LP_CLIENT_IP_HEADER=CF-Connecting-IP

# Proxy used to reach Discord when the server is in mainland China; it must accept LAN connections
# LP_PROVIDERS__HTTP_PROXY=http://host.docker.internal:7890

# Time zone for analytics rollups
# LP_ANALYTICS__TIMEZONE=Asia/Shanghai

# Published port with deploy/compose.direct.yaml
# LINKSPAGE_BIND=127.0.0.1
# LINKSPAGE_PORT=8080

# Alternative registries or mirrors
# LINKSPAGE_IMAGE=ghcr.io/nanako1900/linkspage
# LINKSPAGE_PG_IMAGE=postgres:18-alpine
# LINKSPAGE_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.9.3
# LINKSPAGE_BACKUP_IMAGE=ghcr.io/nanako1900/linkspage-backup

# age public key for encrypted offline backups
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_KEEP_DAYS=14
# BACKUP_UID=1000
