{
  "name": "linkspage-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "lint:css": "stylelint \"src/styles/public*.css\" \"src/styles/tokens.css\" \"../internal/webui/static/*.css\" \"../internal/golink/assets/*.css\"",
    "lint:css:dist": "stylelint \"dist/assets/public-*.css\"",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:lint-rules": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-coverage-include=\"stylelint/*.mjs\" --test-coverage-exclude=\"stylelint/*.test.mjs\" \"stylelint/*.test.mjs\"",
    "size": "size-limit",
    "gen:api": "orval --config orval.config.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "16.34.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@size-limit/file": "14.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.2",
    "orval": "8.40.0",
    "size-limit": "14.1.0",
    "stylelint": "17.16.0",
    "stylelint-no-unsupported-browser-features": "8.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
