{
  "components": {
    "schemas": {
      "Bootstrap": {
        "additionalProperties": false,
        "properties": {
          "page": {
            "$ref": "#/components/schemas/Page"
          },
          "site": {
            "$ref": "#/components/schemas/Settings"
          },
          "version": {
            "description": "Settings version; changes whenever settings change",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "version",
          "page",
          "site"
        ],
        "type": "object"
      },
      "BootstrapOutputBody": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Bootstrap"
          }
        },
        "required": [
          "data"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "Page": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "int32",
            "type": "integer"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug"
        ],
        "type": "object"
      },
      "Palette": {
        "additionalProperties": false,
        "properties": {
          "accent": {
            "type": "string"
          },
          "accentFg": {
            "type": "string"
          },
          "bg": {
            "type": "string"
          },
          "border": {
            "type": "string"
          },
          "card": {
            "type": "string"
          },
          "fg": {
            "type": "string"
          },
          "muted": {
            "type": "string"
          }
        },
        "required": [
          "bg",
          "fg",
          "muted",
          "card",
          "border",
          "accent",
          "accentFg"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Stable machine-readable error code",
            "type": "string"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "requestId": {
            "description": "Request ID for correlating logs",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "Settings": {
        "additionalProperties": false,
        "properties": {
          "appearance": {
            "type": "string"
          },
          "defaultLocale": {
            "type": "string"
          },
          "description": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "locales": {
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "theme": {
            "$ref": "#/components/schemas/Theme"
          },
          "title": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "required": [
          "defaultLocale",
          "locales",
          "title",
          "description",
          "appearance",
          "theme"
        ],
        "type": "object"
      },
      "Theme": {
        "additionalProperties": false,
        "properties": {
          "dark": {
            "$ref": "#/components/schemas/Palette"
          },
          "fontDisplay": {
            "type": "string"
          },
          "fontSans": {
            "type": "string"
          },
          "light": {
            "$ref": "#/components/schemas/Palette"
          },
          "preset": {
            "type": "string"
          },
          "radius": {
            "type": "string"
          }
        },
        "required": [
          "preset",
          "light",
          "dark",
          "radius",
          "fontSans",
          "fontDisplay"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "LinksPage public and admin API. Errors use RFC 9457 problem+json with `code` and `requestId`.",
    "title": "LinksPage API",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/public/bootstrap": {
      "get": {
        "description": "Site settings and the default page. The same document is embedded in HTML as #lp-data.",
        "operationId": "getPublicBootstrap",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapOutputBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Public bootstrap data",
        "tags": [
          "public"
        ]
      }
    }
  }
}
