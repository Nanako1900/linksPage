  "info": {
    "description": "LinksPage public and admin API. Errors use RFC 9457 problem+json with `code` and `requestId`.",
    "title": "LinksPage API",
    "version": "dev"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/public/bootstrap": {
      "get": {
        "description": "The public page DTO. The same document is embedded in HTML as #lp-data.",
        "operationId": "getPublicBootstrap",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapOutputBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Public page data",
        "tags": [
          "public"
        ]
      }
    },
    "/api/v1/public/live": {
      "get": {
        "description": "Frequently changing card data, polled every 60 s while the page is visible. Send If-None-Match; 304 when unchanged. A different revision means the page must be reloaded.",
        "operationId": "getPublicLive",
        "parameters": [
          {
            "description": "ETag of a previous response",
            "in": "header",
            "name": "If-None-Match",
            "schema": {
              "description": "ETag of a previous response",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveOutputBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Not modified"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Live community data",
        "tags": [
          "public"
        ]
      }
    },
    "/api/v1/public/render": {
      "get": {
        "description": "Head fragment, fallback markup, data and CSP of a public page (topology C).",
        "operationId": "getPublicRender",
        "parameters": [
          {
            "description": "Public path: /, /privacy or /c/{slug}",
            "explode": false,
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "description": "Public path: /, /privacy or /c/{slug}",
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Requested language (optional)",
            "explode": false,
            "in": "query",
            "name": "lang",
            "schema": {
              "description": "Requested language (optional)",
              "maxLength": 35,
              "type": "string"
            }
          },
          {
            "description": "Visitor Accept-Language, used when lang is empty",
            "in": "header",
            "name": "Accept-Language",
            "schema": {
              "description": "Visitor Accept-Language, used when lang is empty",
              "type": "string"
            }
          },
          {
            "description": "Shared secret (edge.proxy_auth), required when configured",
            "in": "header",
            "name": "X-LP-Proxy-Auth",
            "schema": {
              "description": "Shared secret (edge.proxy_auth), required when configured",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderOutputBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                }
              },
              "Vary": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
