{{define "head"}}<title>{{.Title}}</title>
<meta name="description" content="{{.Description}}">
{{- if .Robots}}
<meta name="robots" content="{{.Robots}}">
{{- end}}
{{- if .Canonical}}
<link rel="canonical" href="{{.Canonical}}">
{{- range .Alternates}}
<link rel="alternate" hreflang="{{.Lang}}" href="{{.Href}}">
{{- end}}
{{- if .XDefault}}
<link rel="alternate" hreflang="x-default" href="{{.XDefault}}">
{{- end}}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{.SiteName}}">
<meta property="og:title" content="{{.OGTitle}}">
<meta property="og:description" content="{{.OGDescription}}">
<meta property="og:url" content="{{.Canonical}}">
<meta property="og:locale" content="{{.OGLocale}}">
{{- range .OGLocaleAlternates}}
<meta property="og:locale:alternate" content="{{.}}">
{{- end}}
{{- with .OGImage}}
<meta property="og:image" content="{{.URL}}">
<meta property="og:image:width" content="{{.Width}}">
<meta property="og:image:height" content="{{.Height}}">
{{- end}}
<meta name="twitter:card" content="{{.TwitterCard}}">
<meta name="twitter:title" content="{{.OGTitle}}">
<meta name="twitter:description" content="{{.OGDescription}}">
{{- with .OGImage}}
<meta name="twitter:image" content="{{.URL}}">
{{- end}}
<meta itemprop="name" content="{{.OGTitle}}">
<meta itemprop="description" content="{{.OGDescription}}">
{{- with .OGImage}}
<meta itemprop="image" content="{{.URL}}">
{{- end}}
{{- end}}
<meta name="theme-color" content="{{.ThemeColorLight}}" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="{{.ThemeColorDark}}" media="(prefers-color-scheme: dark)">
{{- range .Icons}}
<link rel="{{.Rel}}" type="image/png" sizes="{{.Sizes}}" href="{{.Href}}">
{{- end}}
{{- if .Manifest}}
<link rel="manifest" href="/site.webmanifest">
{{- end}}
<style id="lp-critical">{{.CriticalCSS}}</style>
<style id="lp-theme">{{.ThemeCSS}}</style>
<script>{{.BootScript}}</script>{{end}}
