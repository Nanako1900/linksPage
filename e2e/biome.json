{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": { "includes": ["**", "!test-results", "!playwright-report"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noConsole": "error" }
    }
  }
}
